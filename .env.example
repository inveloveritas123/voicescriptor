# ═══════════════════════════════════════════════════
#  VoiceScriptor v4 — Konfiguration
# ═══════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────
APP_PORT=8470
REPORT_PORT=8480

# ── Whisper (lokale Transkription) ──────────────────
WHISPER_MODEL=base

# ── Telegram Bot (optional) ─────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# ── VoiceScriptor LLM (interne Zusammenfassung) ────
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ── Report Pipeline LLM Provider ───────────────────
# Mindestens einen Key setzen! Dropdown im Dashboard.
REQUESTY_API_KEY=
REQUESTY_MODEL=anthropic/claude-sonnet-4-20250514
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
# Custom/LiteLLM (wird auto-detected auf Port 4000):
CUSTOM_LLM_BASE=
CUSTOM_LLM_KEY=not-needed
CUSTOM_LLM_MODEL=

# ── Nextcloud (WebDAV Upload) ──────────────────────
NEXTCLOUD_URL=http://152.53.142.163:8490
NEXTCLOUD_USER=robert
NEXTCLOUD_PASS=
NEXTCLOUD_FOLDER=YT-Reports

# ── OpenAI Whisper API (optional) ──────────────────
# OPENAI_API_KEY= (oben schon gesetzt)
