# ╔══════════════════════════════════════════════════════════╗
# ║  VoiceScriptor Web — Konfiguration                      ║
# ║  Kopiere nach .env: cp .env.example .env                 ║
# ╚══════════════════════════════════════════════════════════╝

# ── Server ──────────────────────────────────────────────
APP_PORT=8470

# ── Whisper (Lokaler Modus) ─────────────────────────────
# tiny | base | small | medium | large-v3
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
WHISPER_THREADS=4

# ── OpenAI Whisper API (Optional) ───────────────────────
# Nur nötig wenn API-Modus im Dashboard aktiviert wird.
# ACHTUNG: Audio wird an OpenAI-Server gesendet!
OPENAI_API_KEY=

# ── Telegram Bot (Optional) ────────────────────────────
# Bot-Token von @BotFather
TELEGRAM_BOT_TOKEN=
# Komma-getrennte Telegram User-IDs (leer = alle erlaubt)
TELEGRAM_ALLOWED_USERS=

# ── KI-Zusammenfassung (Optional) ──────────────────────
# Jede OpenAI-kompatible API: OpenAI, Groq, Mistral, lokal
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
